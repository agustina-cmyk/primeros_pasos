JIRA_BASE_URL=https://pmvaas1.atlassian.net
JIRA_CLOUD_ID=fd15f28a-875e-4a3c-89f3-fb3c51ed1ba1
JIRA_EMAIL=tu-email@empresa.com
JIRA_API_TOKEN=tu_api_token
JIRA_BOARD_ID=16

# Si lo dejas vacío, se arma automáticamente con JIRA_BOARD_ID:
# board = <JIRA_BOARD_ID> AND statusCategory != Done ORDER BY updated DESC
JIRA_JQL=

# Máximo de tickets por corrida
JIRA_MAX_RESULTS=100

# Campos Jira para enriquecer el mensaje.
# Los custom fields suelen verse como customfield_12345.
JIRA_SECTION_FIELD=
JIRA_CRITICALITY_FIELD=
JIRA_ENVIRONMENT_FIELD=environment
JIRA_TYPE_FIELD=issuetype

# Si una etiqueta comienza con este prefijo se toma como vertical.
# Si en tu caso las verticales se resuelven por etiquetas puntuales, dejalo asi
# y usa LABEL_TO_VERTICAL_JSON.
VERTICAL_LABEL_PREFIX=vertical:

# Mapeo opcional de etiquetas sueltas a verticales (JSON)
# Labels reales del board PS
LABEL_TO_VERTICAL_JSON={"fefo-team":"payments","payments":"payments","eze-team":"verification","borbotones":"verification","pablo-team":"core","frontend":"fe"}

# URLs de canales destino en Roam por vertical
ROAM_API_TOKEN=tu_roam_api_token

# IDs de canal en Roam por vertical (formato C-uuid).
# Para obtenerlos: python main.py --list-roam-chats
ROAM_CHANNEL_IDS_JSON={"payments":"C-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx","verification":"C-...","core":"C-...","fe":"C-..."}

# URLs web de los canales (solo referencia visual en dry-run)
ROAM_CHANNEL_URLS_JSON={"payments":"https://ro.am/r/#/c/Ub93Cr5HRoSA5yd1Cj2shQ/bm9tc2cvbm90aHI","verification":"https://ro.am/r/#/c/zIPlNzFfRzGlVRto-Sdhag/bm9tc2cvbm90aHI","core":"https://ro.am/r/#/c/9tMTXH-EQ62S2VmAHfEaTg/bm9tc2cvbm90aHI","fe":"https://ro.am/r/#/c/prFFf-aKSjG0xJDdSdUjKA/bm9tc2cvbm90aHI"}

# Mapeo vertical -> webhook de Roam (fallback si no hay channel ID)
VERTICAL_WEBHOOKS_JSON={}

# Webhook fallback si no existe uno específico para la vertical
DEFAULT_ROAM_WEBHOOK=

# Tamaño máximo de tickets listados por vertical en el mensaje
MAX_ITEMS_PER_VERTICAL=20

# Ticket estancado = sin cambio de estado en N días corridos
STALE_TICKET_DAYS=15

# Archivo donde el agente guarda memoria entre corridas
AGENT_STATE_PATH=data/agent_state.json

LLM_WEBHOOK_URL=https://n8n.app.getvaas.com/webhook/c0933dd0-864e-4db9-bb65-b003aa8980d2
